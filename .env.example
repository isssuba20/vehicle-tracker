# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API on supabase.com). These two are safe to commit
# once filled in — the anon key is meant to be public; real protection
# comes from the Row Level Security policies in supabase/schema.sql, not
# from keeping this key secret. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
